# Copie este arquivo para .env e preencha com os dados reais.
# O .env fica fora do Git; este exemplo vai para o Git (sem senha!).
# subtype=1: stream leve (detecção); subtype=0: stream principal (clipes)
CAMERA_URL=rtsp://USUARIO:SENHA@IP_DA_CAMERA:554/cam/realmonitor?channel=1&subtype=1

# Telegram: token do @BotFather e id do chat/grupo que recebe os avisos
# (descubra o id com: python src/notificador.py)
TELEGRAM_TOKEN=123456789:SEU_TOKEN_AQUI
TELEGRAM_CHAT_ID=
